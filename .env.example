# ==============================================================================
# SANJIVANI AI - Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your environment-specific values.
# DO NOT commit real '.env' files or sensitive credentials to version control.
# ==============================================================================

# --- General Service Settings ---
PROJECT_NAME="Sanjivani AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"              # Options: development, testing, production
DEBUG=True

# --- Security, Authentication & DPDP Compliance ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-jwt-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# DPDP Act 2023 - 32-byte Base64-encoded Fernet key for field-level PII encryption
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DPDP_ENCRYPTION_KEY="your-32-byte-base64-fernet-key-here-replace-in-prod="

# CORS Allowed Origins (JSON array or comma-separated strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# --- Database Persistence ---
# Default fallback is SQLite for local development / testing:
# DATABASE_URL="sqlite+aiosqlite:///./sanjivani_ai.db"
# SYNC_DATABASE_URL="sqlite:///./sanjivani_ai.db"
# Production PostgreSQL connection string:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sanjivani_ai"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanjivani_ai"

# --- Redis & Celery Background Workers ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- MLOps, Tracking & Vector Database ---
MLFLOW_TRACKING_URI="file:./mlruns"
MODEL_REGISTRY_DIR="models_cache"
CHROMA_PERSIST_DIRECTORY="data/chroma_db"

# --- LLM Layer & Clinical RAG ---
# LLM Provider options: 'offline' (deterministic safety baseline), 'claude', or 'ollama'
LLM_PROVIDER="offline"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-3-haiku-20240307"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:8b"

# --- API Rate Limiting (SlowAPI) ---
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_SCREENING="20/minute"

# --- OCR Engine (Optional path override for Tesseract binary on Windows) ---
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_CMD=""
